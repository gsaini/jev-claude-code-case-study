{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run triage-desk demo *)",
      "Bash(uv run triage-desk eval)",
      "Bash(uv run jev-guard check *)",
      "Bash(uv run jev-guard eval)",
      "Bash(uv run jev-guard log)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.config/jev-guard/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)"
    ]
  },
  "env": {
    "JEV_GUARD_MODE": "shadow"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/bin/python\" -m jev_guard.hook",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    }
  },
  "enabledPlugins": {
    "typesafe@typesafe-ai": true
  }
}
